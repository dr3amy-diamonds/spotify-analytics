# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=spotify_analytics_db

# URL de conexión construida para SQLAlchemy / FastAPI
DATABASE_URL=postgresql://postgres:secret123@localhost:5432/spotify_analytics_db

# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (MongoDB - Bronze)
# ==========================================
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=spotify_raw_db
MONGO_COLLECTION_NAME=streaming_history_raw

# ==========================================
# CONFIGURACIÓN DE API & ENTORNO
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development